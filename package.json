{
  "name": "tourvex-api",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready NestJS API and in-house CRM for Karnish Tourism",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,scripts,test}/**/*.ts\"",
    "format": "prettier --write \"{src,scripts,test}/**/*.ts\" \"*.{json,yml,md}\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:playwright": "playwright test",
    "seed:activities": "tsx scripts/import-activities.ts",
    "seed:media": "tsx scripts/import-media.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:staff": "tsx scripts/seed-staff.ts",
    "seed:holidays": "tsx scripts/seed-holidays.ts",
    "seed:visas": "tsx scripts/seed-visas.ts",
    "seed:cruises": "tsx scripts/seed-cruises.ts",
    "seed:events": "tsx scripts/seed-events.ts",
    "seed:partners": "tsx scripts/seed-partners.ts",
    "seed:cms": "tsx scripts/seed-cms.ts",
    "seed:tax": "tsx scripts/seed-tax.ts",
    "seed:activity-details": "tsx scripts/seed-activity-details.ts",
    "seed:reference-activity": "tsx scripts/seed-reference-activity.ts",
    "seed:crm": "tsx scripts/seed-mock-crm.ts",
    "backfill:vouchers": "tsx scripts/backfill-vouchers.ts",
    "leads:backfill": "tsx scripts/backfill-leads.ts",
    "indexes:verify": "tsx scripts/verify-indexes.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.22.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "helmet": "8.3.0",
    "ioredis": "^5.11.1",
    "mongoose": "9.10.2",
    "multer": "2.4.0",
    "nodemailer": "10.1.0",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@playwright/test": "1.63.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "prettier": "3.8.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "ts-loader": "9.5.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
