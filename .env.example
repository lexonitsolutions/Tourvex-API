NODE_ENV=development
PORT=4100
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/tourvex?replicaSet=rs0
# Clerk (https://dashboard.clerk.com -> API keys). Use sk_test_/pk_test_ locally, sk_live_/pk_live_ in production.
CLERK_SECRET_KEY=sk_test_replace-me
CLERK_PUBLISHABLE_KEY=pk_test_replace-me
# Optional: comma-separated website origins allowed in the session token azp claim (defaults to FRONTEND_URL).
CLERK_AUTHORIZED_PARTIES=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=AED
PAYMENTS_MOCK=true
SUPPLIERS_MOCK=true
DEFAULT_CURRENCY=AED
SUPPORTED_CURRENCIES=*
SUPPORTED_LOCALES=en,ar
WORDPRESS_ACTIVITIES_FILE=../Tourvex-NextJS/app/data/activities.js
MEDIA_SOURCE_DIR=../Tourvex-NextJS/public/images
SEED_ADMIN_EMAIL=
HOLIDAYS_ALLOW_SAMPLES=false
VISAS_ALLOW_SAMPLES=false
CRUISES_ALLOW_SAMPLES=false
EVENTS_ALLOW_SAMPLES=false
# Currency conversion (catalog prices are stored in AED). FX_API_KEY is optional; use a {key} placeholder in the URL if the provider needs one.
FX_API_URL=https://open.er-api.com/v6/latest/AED
FX_API_KEY=
FX_REFRESH_HOURS=6
FX_MAX_AGE_HOURS=72
FX_MARKUP_PERCENT=0
PARTNERS_ALLOW_SAMPLES=false
# Activity booking / checkout
STRIPE_PUBLISHABLE_KEY=
CHECKOUT_TAX_PERCENT=5
CHECKOUT_HOLD_MINUTES=10
CHECKOUT_SWEEP_SECONDS=60
# Show ORIGINAL SAMPLE activity details/options and sample promo codes (seed:activity-details) in production.
ACTIVITY_SAMPLE_DETAILS=false

# Admin audit log: secret salt for hashing caller IPs (set a long random value in production).
AUDIT_IP_SALT=

# CMS: secret used to sign draft preview tokens (falls back to a value derived from CLERK_SECRET_KEY). Set a long random value in production.
CMS_PREVIEW_SECRET=
